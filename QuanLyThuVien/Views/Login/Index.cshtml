@{
    ViewData["Title"] = "Login";
    Layout = "_LoginLayout";
}

<div class="login-container">
    <div class="login-left">
        <img src="~/Images/logo/sach.png" alt="logo">
        <h2>WELCOME TO THE WEBSITE</h2>
        <h2> PHT LIBRARY</h2>
    </div>
    <div class="login-box">
        <h2>LOGIN</h2>
        <form method="post" asp-action="Login">
            <div class="form-group">
                <label for="inputTenDN">Tên Đăng Nhập: </label>
                <input type="text" class="form-control" id="inputTenDN" name="taikhoan" required>
            </div>
            <div class="form-group">
                <label for="inputMK">Mật Khẩu: </label>
                <input type="password" class="form-control" id="inputMK" name="matkhau" required autocomplete="off">
            </div>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" id="rememberMe">
                <label class="form-check-label" for="rememberMe">Remember me</label>
            </div>
            <button type="submit" class="btn btn-primary">LOGIN</button>
        </form>
        <div class="or-login">
            <p>Or login with</p>
            <div class="social-login">
                <button class="btn btn-facebook">Facebook</button>
                <button class="btn btn-google">Google</button>
            </div>
        </div>
        <p class="signup-link">Not a member? <a href="#">Sign up now</a></p>
    </div>
</div>