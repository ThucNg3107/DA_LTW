@model IEnumerable<QuanLyThuVien.Models.Book>

@{
    ViewData["Title"] = "Danh mục sách";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
    <h2 class="text-dark fw-bold">📚 Danh mục sách</h2>
    <div class="d-flex align-items-center flex-wrap">
        <form method="get" asp-action="Index" class="d-flex flex-wrap me-2">
            <div class="me-2">
                <select name="categoryId" class="form-control" onchange="this.form.submit()">
                    <option value="">-- Tất cả thể loại --</option>
                    @foreach (var category in ViewBag.Categories)
                    {
                        @if (ViewData["CategoryId"] != null && (int)ViewData["CategoryId"] == category.CategoryId)
                        {
                            <option value="@category.CategoryId" selected>@category.Name</option>
                        }
                        else
                        {
                            <option value="@category.CategoryId">@category.Name</option>
                        }
                    }
                </select>
            </div>

            <button type="submit" class="btn btn-primary">Tìm Kiếm</button>
        </form>
        <a asp-action="Index" asp-controller="Home" class="btn btn-secondary">
            <i class="bi bi-house-door-fill"></i> Về Trang Chủ
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-lg mt-4 bg-light text-blue">
    <div class="card-body">
        <div class="table-responsive w-100">
            <table class="table table-hover">
                <thead class="table-primary">
                    <tr>
                        <th>ID</th>
                        <th>Ảnh</th>
                        <th>Tên Sách</th>
                        <th>Tác Giả</th>
                        <th>Nhà Xuất Bản</th>
                        <th>Năm XB</th>
                        <th>Thể Loại</th>
                        <th>Trạng Thái</th>
                        <th>Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var book in Model)
                    {
                        <tr>
                            <td>@book.BookId</td>
                            <td>
                                <img src="@book.ImageUrl" alt="Book Image" class="rounded" style="width: 50px; height: 50px; object-fit: cover;">
                            </td>
                            <td>@book.Name</td>
                            <td>@book.Author</td>
                            <td>@book.Publisher</td>
                            <td>@book.PublishedYear</td>
                            <td>@book.Category?.Name</td>
                            <td>
                                <span class="badge @(book.BookStatus == QuanLyThuVien.Models.Book.Status.Available ? "bg-success" :
                                                            (book.BookStatus == QuanLyThuVien.Models.Book.Status.Borrowed ? "bg-warning" : "bg-danger"))">
                                    @if (book.BookStatus == QuanLyThuVien.Models.Book.Status.Available)
                                    {
                                        @:✔ Còn hàng
                                    }
                                    else if (book.BookStatus == QuanLyThuVien.Models.Book.Status.Borrowed)
                                    {
                                        @:📚 Đang mượn
                                    }
                                    else
                                    {
                                        @:❌ Hết hàng
                                    }
                                </span>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@book.BookId" class="btn btn-sm btn-danger mb-1">
                                    Xem Chi Tiết
                                </a>

                                @if (book.BookStatus == QuanLyThuVien.Models.Book.Status.Available)
                                {
                                    <form asp-action="RentBook" method="post" class="d-inline">
                                        <input type="hidden" name="bookId" value="@book.BookId" />
                                        <button type="submit" class="btn btn-sm btn-info">Mượn Sách</button>
                                    </form>
                                }
                                else
                                {
                                    <button disabled class="btn btn-sm btn-secondary">Không có sẵn</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>